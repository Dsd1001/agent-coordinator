{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dsd1001/agent-coordinator/schemas/0.1/extension-manifest.schema.json",
  "title": "ExtensionManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "api_version", "protocol_version", "provides"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{1,95}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "api_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "protocol_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "provides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point", "name"],
        "properties": {
          "point": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{1,95}$"},
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,95}$"}
        }
      }
    }
  }
}
